rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminDoc() { return get(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isActiveAdmin() { return signedIn() && adminDoc().data.active == true; }
    function hasRole(roles) { return isActiveAdmin() && adminDoc().data.role in roles; }
    function isPublishedPublic() { return resource.data.published == true && (!('visibility' in resource.data) || resource.data.visibility == 'PUBLIC'); }

    match /{collection}/{document} {
      allow read: if collection in ['jobs', 'exams', 'results', 'admitCards', 'answerKeys', 'universities', 'organizations', 'categories', 'states', 'siteSettings'] && isPublishedPublic();
      allow read: if isActiveAdmin();
      allow create, update: if hasRole(['SUPER_ADMIN', 'EDITOR', 'CONTENT_MANAGER']);
      allow delete: if hasRole(['SUPER_ADMIN']);
    }

    match /admins/{adminId} {
      allow read: if isActiveAdmin();
      allow write: if hasRole(['SUPER_ADMIN']);
    }

    match /auditLogs/{logId} {
      allow read: if isActiveAdmin();
      allow create: if hasRole(['SUPER_ADMIN', 'EDITOR', 'CONTENT_MANAGER']);
      allow update, delete: if false;
    }
  }
}
