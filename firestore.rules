rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function adminPath() { return /databases/$(database)/documents/admins/$(request.auth.uid); }
    function adminDoc() { return get(adminPath()); }
    function isActiveAdmin() { return signedIn() && exists(adminPath()) && adminDoc().data.active == true; }
    function role() { return adminDoc().data.role; }
    function hasRole(roles) { return isActiveAdmin() && role() in roles; }
    function isPublishedJob() { return resource.data.published == true && resource.data.status == 'PUBLISHED'; }
    function isPublishedPublic() { return resource.data.published == true && (!('visibility' in resource.data) || resource.data.visibility == 'PUBLIC'); }

    match /jobs/{jobId} {
      allow read: if isPublishedJob() || isActiveAdmin();
      allow create: if hasRole(['SUPER_ADMIN', 'EDITOR', 'CONTENT_MANAGER'])
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.published == false;
      allow update: if hasRole(['SUPER_ADMIN', 'EDITOR'])
        || (hasRole(['CONTENT_MANAGER']) && request.resource.data.status in ['DRAFT', 'UNPUBLISHED'] && request.resource.data.published == false);
      allow delete: if false;
    }

    match /{collection}/{document} {
      allow read: if collection in ['exams', 'results', 'admitCards', 'answerKeys', 'universities', 'organizations', 'categories', 'states', 'siteSettings'] && isPublishedPublic();
      allow read: if isActiveAdmin();
      allow create, update: if hasRole(['SUPER_ADMIN', 'EDITOR', 'CONTENT_MANAGER']);
      allow delete: if hasRole(['SUPER_ADMIN']);
    }

    match /admins/{adminId} {
      allow read: if isActiveAdmin() && (request.auth.uid == adminId || hasRole(['SUPER_ADMIN']));
      allow write: if hasRole(['SUPER_ADMIN']);
    }

    match /auditLogs/{logId} {
      allow read: if isActiveAdmin();
      allow create: if hasRole(['SUPER_ADMIN', 'EDITOR', 'CONTENT_MANAGER', 'VIEWER'])
        && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
